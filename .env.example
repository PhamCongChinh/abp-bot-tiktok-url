# =============================================================================
# ABP Bot TikTok URL — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.

# --- Required ----------------------------------------------------------------

# Human-readable name for this bot instance (used in MongoDB bot_config)
BOT_NAME=bot-tiktok-url-01

# Comma-separated list of organisation IDs to crawl URLs for
ORG_IDS=1,2,3

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017

# MongoDB database name
MONGO_DB=sls_tiktok

# GPM (GoLogin Profile Manager) API base URL
GPM_API=http://localhost:50325/api/v1

# --- Optional (defaults shown) -----------------------------------------------

# Comma-separated GPM profile IDs (empty = local Chrome without GPM)
# PROFILE_IDS=profile-1,profile-2

# Backend API base URL for pushing crawled videos (empty = push disabled)
# API_URL=http://localhost:8080/api

# Directory for output data and logs
# OUTPUT_DIR=./data

# Enable debug mode (run once immediately instead of scheduled intervals)
# DEBUG=false

# --- Logging -----------------------------------------------------------------

# Minimum log level: debug | info | warn | error
# LOG_LEVEL=info

# Maximum log file size in MB before rotation
# LOG_MAX_SIZE_MB=100

# Maximum number of days to retain old log files
# LOG_MAX_AGE_DAYS=7

# Maximum number of rotated log files to keep
# LOG_MAX_BACKUPS=7

# --- MongoDB pool ------------------------------------------------------------

# Maximum concurrent MongoDB connections
# MONGO_MAX_POOL_SIZE=100

# Minimum idle MongoDB connections to maintain
# MONGO_MIN_POOL_SIZE=10

# --- API client --------------------------------------------------------------

# HTTP request timeout in seconds
# HTTP_TIMEOUT_SECONDS=30

# --- URLs (optional — if empty, URLs are loaded from MongoDB only) -----------

# Comma-separated fallback TikTok URLs (video or profile pages)
# URLS=https://www.tiktok.com/@someuser,https://www.tiktok.com/@otheruser/video/7123456789012345678

# --- Crawl timing (seconds) --------------------------------------------------

# Sleep range between URLs (min–max)
# SLEEP_MIN_URL=60
# SLEEP_MAX_URL=180

# Rest range between full crawl sessions (min–max)
# REST_MIN_SESSION=180
# REST_MAX_SESSION=300

# --- Batch limits ------------------------------------------------------------

# Number of URLs to collect per batch (min–max)
# BATCH_MIN=3
# BATCH_MAX=5

# --- Pagination guards -------------------------------------------------------

# Maximum videos to collect per URL before stopping (mainly relevant for
# profile URLs, which can yield many videos as the page scrolls)
# MAX_VIDEOS_PER_URL=200

# Maximum scroll pages per crawl session
# MAX_PAGES_PER_SESSION=20

# --- Observability ------------------------------------------------------------

# Prometheus metrics HTTP server listen address (empty = disabled)
# METRICS_ADDR=:9090
